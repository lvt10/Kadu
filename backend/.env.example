# ─── Backend — Variáveis de Ambiente ─────────────────────────────────────────
# Copie para .env localmente.
# No Azure: configure em App Service > Settings > Environment variables

# Porta (Azure define PORT automaticamente, não precisa alterar)
PORT=3001

# Chave secreta para assinar tokens JWT — TROQUE em produção!
JWT_SECRET=troque-para-uma-chave-longa-e-aleatoria-em-producao

# Caminho do banco SQLite
# Azure App Service: deixe em branco — o servidor usa /home/data/escola.db automaticamente
# Local: deixe em branco para usar ./escola.db
DB_PATH=

# Origens permitidas pelo CORS — separadas por vírgula, sem espaços
# Inclua o domínio do Azure Static Web Apps após o deploy
CORS_ORIGIN=http://localhost:5173,http://localhost:3000,https://SEU-APP.azurestaticapps.net
